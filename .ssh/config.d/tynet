################################################################################
# github
################################################################################
Host github.com
  IdentityFile ~/.ssh/github
  Hostname ssh.github.com
  StrictHostKeyChecking accept-new
  ControlMaster no
  Port 443
  User git

################################################################################
# tynet hosts
################################################################################
Host vader vader.local
  ForwardAgent yes
  User ty

Host pi1* pi2* pi3* pi4* vpn* kickstart*
  ForwardAgent yes
  User ty

Host pi2* pi3*
  ForwardAgent yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host 10.0.50.*
  ForwardAgent yes
  User alexandt

Host 10.0.50.2 unifi.tynet.us
  ForwardAgent yes
  User root

Host *-ap.tynet.us *-router.tynet.us *switch.tynet.us *switch-poe.tynet.us
  ForwardAgent yes
  User alexandt

Host 127.0.0.1 localhost
  ForwardAgent yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile /dev/null
  Port 2222
  User ty

Host *
  ServerAliveInterval 30
